{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.exit(require('child_process').spawnSync(process.execPath, [require('path').join(process.env.CLAUDE_PLUGIN_ROOT, 'skills', 'siteproof', 'scripts', 'setup.mjs'), '--hook'], { stdio: 'inherit' }).status ?? 0)\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('url').pathToFileURL(require('path').join(process.env.CLAUDE_PLUGIN_ROOT, 'hooks', 'guard.mjs'))).then(m => m.main())\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
